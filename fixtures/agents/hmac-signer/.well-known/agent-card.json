{
  "name": "HMAC Signer",
  "description": "Demo fixture (Spellwarden live demo). Confirms delivery receipts.",
  "version": "1.0.0",
  "supportedInterfaces": [
    {
      "url": "https://receipts.example.com/a2a",
      "protocolBinding": "JSONRPC",
      "protocolVersion": "1.0"
    }
  ],
  "provider": {
    "organization": "Example Freight",
    "url": "https://example.com"
  },
  "capabilities": {
    "streaming": false
  },
  "securitySchemes": {
    "oauth": {
      "oauth2SecurityScheme": {
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://auth.example.com/authorize",
            "tokenUrl": "https://auth.example.com/token",
            "scopes": {
              "receipts.write": "Confirm receipts"
            },
            "pkceRequired": true
          }
        }
      }
    }
  },
  "securityRequirements": [
    {
      "schemes": {
        "oauth": {
          "list": [
            "receipts.write"
          ]
        }
      }
    }
  ],
  "defaultInputModes": [
    "text/plain"
  ],
  "defaultOutputModes": [
    "text/plain"
  ],
  "skills": [
    {
      "id": "confirm-receipt",
      "name": "Confirm a receipt",
      "description": "Confirms one delivery receipt.",
      "tags": [
        "receipts"
      ]
    }
  ],
  "signatures": [
    {
      "protected": "eyJhbGciOiJIUzI1NiIsImtpZCI6ImRlbW8ifQ",
      "signature": "ZGVtby1zaWduYXR1cmUtbm90LXJlYWw"
    }
  ]
}
